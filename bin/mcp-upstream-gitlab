#!/bin/sh
# Wrapper that locates an installed upstream GitLab MCP server (mcp-gitlab or
# gitlab-mcp) on PATH and runs it with the project environment loaded (via
# bin/bubo-env). The GitLab provider posts inline MR review comments through it.
set -eu
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${BUBO_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
if command -v mcp-gitlab >/dev/null 2>&1; then
    MCP_BIN="$(command -v mcp-gitlab)"
elif command -v gitlab-mcp >/dev/null 2>&1; then
    MCP_BIN="$(command -v gitlab-mcp)"
else
    echo "mcp-gitlab or gitlab-mcp is required" >&2
    exit 127
fi
exec "$ROOT/bin/bubo-env" "$MCP_BIN" "$@"

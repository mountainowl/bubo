#!/bin/sh
# Repo-root launcher for `bubo-poller` — runs one review poll cycle (discover
# open changes, review, post findings; also drives --sync-outcomes, --health,
# and the --backfill imports). Loads runtime config via bin/bubo-env, then runs the
# packaged console script through uv against $BUBO_ROOT.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${BUBO_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
exec "$ROOT/bin/bubo-env" uv run --project "$ROOT" bubo-poller "$@"

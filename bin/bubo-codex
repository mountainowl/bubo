#!/bin/sh
# Repo-root launcher for `bubo-codex`, the bundled default review agent: it
# renders the code-reviewer meta prompt and drives `codex exec` to produce
# findings. The BUBO_SKIP_AGENT_CONFIG_ENV=1 branch skips bin/bubo-env when the
# caller (e.g. the poller) has already loaded the runtime environment.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${BUBO_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
if [ "${BUBO_SKIP_AGENT_CONFIG_ENV:-0}" = "1" ]; then
    PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin:$PATH"
    export PATH BUBO_ROOT="$ROOT"
    exec uv run --project "$ROOT" bubo-codex "$@"
fi
exec "$ROOT/bin/bubo-env" uv run --project "$ROOT" bubo-codex "$@"

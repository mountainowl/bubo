#!/bin/sh
# Launcher for the bubo MCP server.
# Mirrors the bin/bubo-poller pattern so the server inherits the same
# env loading (bin/env -> config/env.toml -> exported runtime vars).
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${BUBO_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
exec "$ROOT/bin/env" uv run --project "$ROOT" bubo-mcp "$@"

#!/bin/sh
# Launcher for the llm-reviewer MCP server.
# Mirrors the bin/mr-review-poller pattern so the server inherits the same
# env loading (bin/env -> config/env.toml -> exported runtime vars).
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${LLM_CODE_REVIEW_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
exec "$ROOT/bin/env" uv run --project "$ROOT" mcp-llm-reviewer "$@"
